    "# 6.2 文件I/O\n",
    "print(\"\\n=== 6.2 文件I/O ===\")\n",
    "# 写文件\n",
    "with open(\"test.txt\", \"w\") as f:\n",
    "    f.write(\"Hello File!\\n\")\n",
    "# 读文件\n",
    "with open(\"test.txt\", \"r\") as f:\n",
    "    content = f.read()\n",
    "print(content)\n",
    "# 清理：实际运行后删除test.txt"
   ]
  }
